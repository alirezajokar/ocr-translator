{
  "name": "ocr-translator",
  "version": "0.1.0",
  "description": "Screenshot a bit of your screen, OCR it, and translate it on demand — a background utility for Ubuntu/GNOME (Wayland)",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --linux AppImage deb"
  },
  "keywords": [
    "electron",
    "ocr",
    "translation",
    "screenshot",
    "gnome",
    "linux"
  ],
  "author": {
    "name": "alireza",
    "email": "alirezajokar1@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alirezajokar/ocr-translator.git"
  },
  "homepage": "https://github.com/alirezajokar/ocr-translator#readme",
  "bugs": {
    "url": "https://github.com/alirezajokar/ocr-translator/issues"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "dbus-next": "^0.10.2",
    "openai": "^7.8.0",
    "tesseract.js": "^7.0.0"
  },
  "build": {
    "appId": "dev.alireza.ocrtranslator",
    "productName": "OCR Translator",
    "directories": {
      "output": "dist"
    },
    "asarUnpack": [
      "assets/**/*"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "assets/app-icon.png"
    },
    "publish": {
      "provider": "github",
      "owner": "alirezajokar",
      "repo": "ocr-translator",
      "releaseType": "release"
    }
  }
}
